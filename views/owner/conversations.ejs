<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<%- include('../partials/head.ejs') %>
<body>
<script src="/assets/static/js/initTheme.js"></script>
<div id="app">
  <%- include('../partials/sidebar.ejs') %>

  <div id="main" class="layout-navbar">
       <header class="mb-3">
                <a href="#" class="burger-btn d-block d-xl-none">
                    <i class="bi bi-justify fs-3"></i>
                </a>
            </header>

    <!-- Page Content -->
    <div class="page-content px-3 px-lg-5">
      <section class="section">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="fw-bolder">المحادثات</h3>
          <button class="btn btn-primary rounded-pill shadow-sm"><i class="bi bi-plus-lg me-2"></i>محادثة جديدة</button>
        </div>

        <!-- Card Container -->
        <div class="card border-0 shadow-lg overflow-hidden" style="height: calc(100vh - 220px); border-radius: 24px;">
          <div class="row g-0 h-100">

            <!-- Sidebar: قائمة المحادثات -->
            <div class="col-lg-4 col-xxl-3 border-end d-flex flex-column">
              <div class="p-3 border-bottom bg-light">
                <h5 class="mb-0 fw-bold">محادثاتي</h5>
              </div>
              <div id="conversation-list" class="flex-grow-1 overflow-auto p-2">
                <% if (conversations && conversations.length > 0) { %>
                  <div class="list-group list-group-flush">
                    <% conversations.forEach(conv => { %>
                      <a href="#" class="list-group-item list-group-item-action conversation-item rounded-3 my-2 py-3"
                         data-id="<%= conv._id %>" data-title="<%= conv.title || 'محادثة' %>" data-online="<%= conv.online || false %>">
                        <div class="d-flex align-items-center">
                          <div class="position-relative me-3">
                            <img src="<%= conv.avatar || '/assets/compiled/jpg/1.jpg' %>" class="avatar avatar-md rounded-circle" alt="">
                            <span class="position-absolute bottom-0 end-0 p-1 bg-<%= conv.online ? 'success' : 'secondary' %> rounded-circle border border-2 border-white"></span>
                          </div>
                          <div class="flex-grow-1 overflow-hidden">
                            <h6 class="mb-1 text-truncate fw-bold"><%= conv.title || 'محادثة' %></h6>
                            <p class="small text-muted mb-0 text-truncate"><%= conv.lastMessage || 'لا رسائل بعد' %></p>
                          </div>
                          <div class="text-end ms-2">
                            <% if (conv.unread > 0) { %>
                              <span class="badge bg-primary rounded-pill"><%= conv.unread %></span>
                            <% } %>
                          </div>
                        </div>
                      </a>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="text-center text-muted p-5">
                    <i class="bi bi-chat-dots fs-1 mb-3"></i>
                    <p>لا توجد محادثات حالياً</p>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Chat Area -->
            <div class="col-lg-8 col-xxl-9 d-flex flex-column">
              <div id="chat-header" class="d-flex align-items-center p-3 border-bottom" style="display: none;">
                <img id="header-avatar" src="/assets/compiled/jpg/1.jpg" class="avatar avatar-md rounded-circle me-3" alt="">
                <div class="flex-grow-1">
                  <h5 id="chat-title" class="mb-0 fw-bold">اختر محادثة</h5>
                  <small id="chat-status" class="text-muted">غير متصل</small>
                </div>
                <div class="d-flex gap-2">
                  <button class="btn btn-icon btn-outline-secondary rounded-circle"><i class="bi bi-search"></i></button>
                  <button class="btn btn-icon btn-outline-secondary rounded-circle"><i class="bi bi-telephone"></i></button>
                  <button class="btn btn-icon btn-outline-secondary rounded-circle"><i class="bi bi-camera-video"></i></button>
                  <button class="btn btn-icon btn-outline-secondary rounded-circle"><i class="bi bi-three-dots-vertical"></i></button>
                </div>
              </div>

              <!-- Messages -->
              <div id="chat-messages" class="flex-grow-1 overflow-auto p-3" style="scroll-behavior: smooth;">
                <div class="text-center text-muted my-5 d-flex flex-column align-items-center">
                  <i class="bi bi-chat-heart-fill fs-1 text-primary mb-3"></i>
                  <h5 class="fw-bold">ابدأ محادثة جديدة</h5>
                  <p class="lead">اختر محادثة من القائمة لبدء الدردشة</p>
                </div>
              </div>

              <!-- Input Area ثابت -->
              <div id="chat-input-area" class="p-3 border-top" style="display: none;">
                <div class="input-group input-group-lg rounded-pill overflow-hidden">
                  <button class="btn btn-outline-secondary border-0" id="file-btn"><i class="bi bi-paperclip"></i></button>
                  <input type="file" id="file-input" style="display:none;">
                  <button class="btn btn-outline-secondary border-0" id="emoji-btn"><i class="bi bi-emoji-smile"></i></button>
                  <input type="text" id="chat-input" class="form-control border-0" placeholder="اكتب رسالتك هنا..." disabled>
                  <button class="btn btn-primary px-4" id="send-btn" disabled><i class="bi bi-send-fill"></i></button>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>
    </div>

    <footer class="text-center py-4 text-muted small">
      2026 &copy; Sanabel Youth & Development Foundation
    </footer>
  </div>
</div>

<!-- Scripts -->
     <script src="/assets/static/js/components/dark.js"></script>

<script src="/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="/assets/compiled/js/app.js"></script>

<script>
  // PerfectScrollbar
  const convPS = new PerfectScrollbar('#conversation-list', { wheelPropagation: false });
  const messagesPS = new PerfectScrollbar('#chat-messages', { wheelPropagation: false });

  const convItems = document.querySelectorAll('.conversation-item');
  const chatHeader = document.getElementById('chat-header');
  const headerAvatar = document.getElementById('header-avatar');
  const chatTitle = document.getElementById('chat-title');
  const chatStatus = document.getElementById('chat-status');
  const chatMessages = document.getElementById('chat-messages');
  const chatInputArea = document.getElementById('chat-input-area');
  const chatInput = document.getElementById('chat-input');
  const sendBtn = document.getElementById('send-btn');

  let currentConvId = null;

  convItems.forEach(item => {
    item.addEventListener('click', async (e) => {
      e.preventDefault();
      convItems.forEach(i => i.classList.remove('active'));
      item.classList.add('active');

      currentConvId = item.dataset.id;
      const title = item.dataset.title;
      const online = item.dataset.online === 'true';

      chatHeader.style.display = 'flex';
      chatInputArea.style.display = 'block';
      chatInput.disabled = false;
      sendBtn.disabled = false;

      chatTitle.textContent = title;
      chatStatus.textContent = online ? 'متصل الآن' : 'غير متصل';
      chatStatus.className = online ? 'text-success fw-bold' : 'text-muted';

      headerAvatar.src = item.querySelector('img').src;

      chatMessages.innerHTML = '<div class="text-center my-5"><div class="spinner-border text-primary"></div></div>';

      try {
        const res = await fetch(`/api/conversations/${currentConvId}/messages?limit=50`);
        const data = await res.json();

        chatMessages.innerHTML = '';
        if (data.messages && data.messages.length > 0) {
          data.messages.forEach(msg => appendMessage(msg));
        } else {
          chatMessages.innerHTML = '<div class="text-center text-muted my-5">ابدأ المحادثة الآن!</div>';
        }
        messagesPS.update();
        chatMessages.scrollTop = chatMessages.scrollHeight;
      } catch (err) {
        chatMessages.innerHTML = '<div class="text-center text-danger my-5">فشل تحميل الرسائل</div>';
      }
    });
  });

  function appendMessage(msg) {
    const isMe = msg.senderId === '<%= user.id %>';
    const bubble = document.createElement('div');
    bubble.className = `d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'} mb-3`;
    bubble.innerHTML = `
      <div class="${isMe ? 'ms-3' : 'me-3'}">
        <div class="p-3 rounded-3 shadow-sm ${isMe ? 'bg-primary text-white' : 'bg-light text-dark'}" style="max-width:70%; border-radius:16px;">
          ${!isMe ? `<small class="fw-bold d-block mb-1">${msg.sender}</small>` : ''}
          <p class="mb-1">${msg.content}</p>
          <small class="d-block text-end ${isMe ? 'text-white-50' : 'text-muted'}">${msg.time}</small>
        </div>
      </div>
    `;
    chatMessages.appendChild(bubble);
    messagesPS.update();
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function sendMessage() {
    const content = chatInput.value.trim();
    if (!content || !currentConvId) return;

    appendMessage({ senderId: '<%= user.id %>', sender: 'أنت', content, time: new Date().toLocaleTimeString('ar', {hour:'2-digit', minute:'2-digit'}) });
    chatInput.value = '';
  }

  sendBtn.addEventListener('click', sendMessage);
  chatInput.addEventListener('keypress', e => { if(e.key==='Enter') sendMessage(); });
</script>

<style>
  .avatar-md { width:48px; height:48px; object-fit:cover; }
  .chat-area { background: #f8f9fa; display:flex; flex-direction:column; height:100%; }
  #chat-messages { flex-grow:1; overflow:auto; }
  #conversation-list { height:100%; overflow:auto; }
  .conversation-item.active { background-color:#6366f1; color:white !important; }
  .conversation-item.active * { color:white !important; }
</style>
</body>
</html>
