<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<%- include('./partials/head.ejs') %>
<body>
<script src="/assets/static/js/initTheme.js"></script>
<div id="app">
  <%- include('./partials/sidebar.ejs') %>

  <div id="main" class="layout-navbar">
    <header class="mb-3">
      <a href="#" class="burger-btn d-block d-xl-none">
        <i class="bi bi-justify fs-3"></i>
      </a>
    </header>

    <div class="page-heading">
      <h3>إدارة المجموعات</h3>
    </div>

    <div class="page-content px-3 px-lg-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted">إدارة مجموعات التواصل الخاصة بك</p>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newGroupModal">
          <i class="bi bi-plus-lg me-2"></i>مجموعة جديدة
        </button>
      </div>

      <div class="row" id="groups-container">
        <div class="text-center p-5">
          <div class="spinner-border text-primary"></div>
          <p class="mt-2">جاري التحميل...</p>
        </div>
      </div>
    </div>

    <footer class="text-center py-4 text-muted small">
      2026 &copy; مؤسسة السنابل للشباب والتنمية
    </footer>
  </div>
</div>

<!-- Modal: مجموعة جديدة -->
<div class="modal fade" id="newGroupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">إنشاء مجموعة جديدة</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="new-group-form">
          <div class="mb-3">
            <label class="form-label">اسم المجموعة *</label>
            <input type="text" class="form-control" id="group-name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">نوع المجموعة</label>
            <select class="form-select" id="group-type">
              <option value="custom">مخصص</option>
              <option value="program">برنامج</option>
              <option value="department">قسم</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">النطاق</label>
            <select class="form-select" id="group-scope">
              <option value="company">الشركة</option>
              <option value="department">القسم</option>
              <option value="private">خاص</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button type="button" class="btn btn-primary" id="create-group-btn">إنشاء</button>
      </div>
    </div>
  </div>
</div>

<script src="/assets/static/js/components/dark.js"></script>
<script src="/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="/assets/compiled/js/app.js"></script>
<script>
  // Load Groups
  async function loadGroups() {
    try {
      const res = await fetch('/api/groups/mine');
      const groups = await res.json();
      renderGroups(groups);
    } catch (error) {
      console.error('Error loading groups:', error);
      document.getElementById('groups-container').innerHTML = `
        <div class="col-12">
          <div class="alert alert-danger">فشل تحميل المجموعات</div>
        </div>
      `;
    }
  }

  // Render Groups
  function renderGroups(groups) {
    const container = document.getElementById('groups-container');
    
    if (!groups || groups.length === 0) {
      container.innerHTML = `
        <div class="col-12">
          <div class="card">
            <div class="card-body text-center py-5">
              <i class="bi bi-people fs-1 text-muted mb-3"></i>
              <h5>لا توجد مجموعات</h5>
              <p class="text-muted">ابدأ بإنشاء مجموعة جديدة</p>
              <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newGroupModal">
                <i class="bi bi-plus-lg me-2"></i>إنشاء مجموعة
              </button>
            </div>
          </div>
        </div>
      `;
      return;
    }

    const html = groups.map(group => `
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h5 class="card-title mb-0">${group.name}</h5>
              <span class="badge bg-${getScopeColor(group.scope)}">${getScopeLabel(group.scope)}</span>
            </div>
            <p class="text-muted small mb-2">
              <i class="bi bi-tag me-1"></i>${getTypeLabel(group.type)}
            </p>
            <p class="text-muted small mb-3">
              <i class="bi bi-people me-1"></i>${group.members?.length || 0} عضو
            </p>
            <div class="d-flex gap-2">
              <a href="/owner/conversations?group=${group._id}" class="btn btn-sm btn-primary flex-grow-1">
                <i class="bi bi-chat me-1"></i>فتح المحادثة
              </a>
              <button class="btn btn-sm btn-outline-secondary" onclick="viewGroupDetails('${group._id}')">
                <i class="bi bi-info-circle"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    container.innerHTML = html;
  }

  function getScopeColor(scope) {
    const colors = {
      company: 'primary',
      department: 'info',
      private: 'success'
    };
    return colors[scope] || 'secondary';
  }

  function getScopeLabel(scope) {
    const labels = {
      company: 'الشركة',
      department: 'القسم',
      private: 'خاص'
    };
    return labels[scope] || scope;
  }

  function getTypeLabel(type) {
    const labels = {
      custom: 'مخصص',
      program: 'برنامج',
      department: 'قسم'
    };
    return labels[type] || type;
  }

  // Create Group
  document.getElementById('create-group-btn').addEventListener('click', async () => {
    const name = document.getElementById('group-name').value;
    const type = document.getElementById('group-type').value;
    const scope = document.getElementById('group-scope').value;

    if (!name.trim()) {
      alert('يرجى إدخال اسم المجموعة');
      return;
    }

    try {
      const res = await fetch('/api/groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, type, scope })
      });

      if (res.ok) {
        const group = await res.json();
        bootstrap.Modal.getInstance(document.getElementById('newGroupModal')).hide();
        document.getElementById('new-group-form').reset();
        loadGroups();
      } else {
        const error = await res.json();
        alert('خطأ: ' + (error.error || 'فشل إنشاء المجموعة'));
      }
    } catch (error) {
      console.error('Error creating group:', error);
      alert('فشل إنشاء المجموعة');
    }
  });

  function viewGroupDetails(groupId) {
    // TODO: Implement group details modal
    alert('تفاصيل المجموعة: ' + groupId);
  }

  // Load on page load
  loadGroups();
</script>
</body>
</html>
